@page "{id:int}"
@model ITI_Project.Pages.Departments.DeleteModel

@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>

<h3>Are you sure you want to delete this department?</h3>

<div class="mb-4">
    <dl class="row">
        <dt class="col-sm-3">Department Name</dt>
        <dd class="col-sm-9">@Model.Department.Name</dd>
    </dl>
</div>

<form asp-page="Delete" method="post">
    <input type="hidden" asp-for="Department.Id" />
    <button type="submit" class="btn btn-danger">
        <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        Delete
    </button>
    <a asp-page="Index" class="btn btn-secondary">
        <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        Cancel
    </a>
</form>
