@page "{id:int}"
@model ITI_Project.Pages.Departments.DetailsModel

<h1>Department Details</h1>

<div>
    <dl class="row">

        <dt class="col-sm-2">
            ID
        </dt>

        <dd class="col-sm-10">
            @Model.Department.Id
        </dd>

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.Department.Name
        </dd>

    </dl>
</div>

<a asp-page="Edit"
   asp-route-id="@Model.Department.Id"
   class="btn btn-primary">
    Edit
</a>

<a asp-page="Index"
   class="btn btn-secondary">
    Back to List
</a>