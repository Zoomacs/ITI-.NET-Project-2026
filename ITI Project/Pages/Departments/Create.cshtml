@page
@model ITI_Project.Pages.Departments.CreateModel

<h1>Create Department</h1>

<form method="post">

    <div class="mb-3">
        <label asp-for="Department.Name" class="form-label"></label>

        <input asp-for="Department.Name" class="form-control" />

        <span asp-validation-for="Department.Name"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Back to List
    </a>

</form>