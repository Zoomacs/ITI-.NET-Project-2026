@model IEnumerable<ITI_Project.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Employees</h1>
    <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        Add New Employee
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Employee List</h6>
    </div>
    <div class="card-body">

        <form asp-action="Index" method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                       class="form-control" placeholder="Write name or email..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Department</label>
                <select name="departmentId" class="form-select">
                    <option value="">-- All Departments --</option>
                    @foreach (var dept in (IEnumerable<ITI_Project.Models.Department>)ViewBag.Departments)
                    {
                        <option value="@dept.Id" selected="@(ViewBag.CurrentDepartmentId == dept.Id)">
                            @dept.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Job Title</label>
                <select name="jobTitleId" class="form-select">
                    <option value="">-- All Job Titles --</option>
                    @foreach (var job in (IEnumerable<ITI_Project.Models.JobTitle>)ViewBag.JobTitles)
                    {
                        <option value="@job.Id" selected="@(ViewBag.CurrentJobTitleId == job.Id)">
                            @job.Title
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary me-2">
                    <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <svg class="me-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                    Reset
                </a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Image</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Job Title</th>
                        <th>Hire Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td>@employee.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(employee.ProfileImagePath))
                                    {
                                        <img src="@employee.ProfileImagePath"
                                             alt="@employee.FullName"
                                             width="60" height="60" style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-gray-600">No Image</span>
                                    }
                                </td>
                                <td>@employee.FullName</td>
                                <td>@employee.Email</td>
                                <td>@employee.Department?.Name</td>
                                <td>@employee.JobTitle?.Title</td>
                                <td>@employee.HireDate.ToShortDateString()</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-info">
                                        <svg class="me-1" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-warning">
                                        <svg class="me-1" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-danger">
                                        <svg class="me-1" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">No employees found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
