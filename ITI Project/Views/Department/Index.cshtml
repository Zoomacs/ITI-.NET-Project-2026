@model IEnumerable<ITI_Project.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<h2>Departments</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Department</a>
</p>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
               class="form-control" placeholder="Write department name..." />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary me-2">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Department Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var dept in Model)
            {
                <tr>
                    <td>@dept.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@dept.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">No departments found.</td>
            </tr>
        }
    </tbody>
</table>